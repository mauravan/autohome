# Copy to secrets.yaml (git-ignored) and fill in.
# MQTT credentials are configured at runtime via the web UI; no compile-time
# secrets are required for MQTT. Keep ota_password for all builds and
# ota_signing_key for the (currently unused) co2-node-secure.yaml package.
ota_password: "CHANGE-ME-OTA"
ota_signing_key: "/path/to/ota_signing_key.pem"  # path to PEM used by co2-node-secure.yaml (product builds)
