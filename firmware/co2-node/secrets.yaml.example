# Copy to secrets.yaml (git-ignored) and fill in.
mqtt_username: "mqtt_user"          # MUST equal HA /config/secrets.yaml mqtt_username
mqtt_password: "YOUR_MQTT_PASSWORD" # MUST equal HA /config/secrets.yaml mqtt_password
ota_password: "CHANGE-ME-OTA"
ota_signing_key: "/path/to/ota_signing_key.pem"  # path to PEM used by co2-node-secure.yaml (product builds)
