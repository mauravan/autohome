[connection]
id=autohome-wifi
type=wifi
autoconnect=true
autoconnect-priority=100

[wifi]
mode=infrastructure
ssid=YOUR_SSID_HERE
hidden=false

[wifi-security]
key-mgmt=wpa-psk
psk=YOUR_WPA2_PSK_HERE

[ipv4]
method=auto
# For static IP, use:
# method=manual
# address1=192.168.1.100/24,192.168.1.1
# dns=192.168.1.1;8.8.8.8

[ipv6]
method=auto

[proxy]